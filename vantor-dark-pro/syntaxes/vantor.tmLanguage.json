{
  "name": "Vantor",
  "scopeName": "source.vnt",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.vnt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vnt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vnt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "string.escape.vnt",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.vnt",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.vnt",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "constant.numeric.hex.vnt",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vnt",
          "match": "\\b(if|else|match|loop|while|for|in|return|break|continue|yield)\\b"
        },
        {
          "name": "keyword.other.vnt",
          "match": "\\b(pub|priv|static|const|mut|async|await|try|catch|throw|panic|as|is|where|impl|trait|enum|struct|class|interface|type|alias|use|mod|import|export|from|module)\\b"
        },
        {
          "name": "keyword.operator.vnt",
          "match": "->|=>|::|@"
        },
        {
          "name": "storage.type.vnt",
          "match": "\\b(fn|let|var|val)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.vnt",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "storage.type.primitive.vnt",
          "match": "\\b(void|int|uint|i8|u8|i16|u16|i32|u32|i64|u64|f32|f64|bool|string|char|byte|nil|true|false)\\b"
        },
        {
          "name": "support.type.vnt",
          "match": "\\b(Result|Option|Vector|Map|Set|String|Box|Rc|Arc|Future|Promise|Task)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.vnt",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readonly.vnt",
          "match": "\\b[A-Z_][A-Z0-9_]+\\b"
        },
        {
          "name": "variable.vnt",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vnt",
          "match": "=>|<-|->|\\+\\+|\\+\\=|\\-\\-|\\-\\=|\\*\\*|\\*\\=|\\/\\/|\\/\\=|%|%\\=|==|!=|<=|>=|&&|\\|\\||&|\\||\\^|~|<<|>>"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.vnt",
          "match": "[,;]"
        },
        {
          "name": "punctuation.brackets.vnt",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
