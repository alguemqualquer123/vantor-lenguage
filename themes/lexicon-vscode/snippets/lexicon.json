{
	"Main Function": {
		"prefix": "main",
		"body": [
			"pub fn main() {",
			"\t$0",
			"}"
		],
		"description": "Main entry point function"
	},
	"Main Async": {
		"prefix": "maina",
		"body": [
			"pub async fn main() -> void {",
			"\t$0",
			"}"
		],
		"description": "Async main entry point function"
	},
	"Function": {
		"prefix": "fn",
		"body": [
			"fn ${1:name}($2) -> ${3:void} {",
			"\t$0",
			"}"
		],
		"description": "Function declaration"
	},
	"Public Function": {
		"prefix": "pfn",
		"body": [
			"pub fn ${1:name}($2) -> ${3:void} {",
			"\t$0",
			"}"
		],
		"description": "Public function declaration"
	},
	"Async Function": {
		"prefix": "afn",
		"body": [
			"pub async fn ${1:name}($2) -> ${3:void} {",
			"\t$0",
			"}"
		],
		"description": "Async function declaration"
	},
	"Public Async Function": {
		"prefix": "pafn",
		"body": [
			"pub async fn ${1:name}($2) -> ${3:void} {",
			"\t$0",
			"}"
		],
		"description": "Public async function declaration"
	},
	"Nested Function": {
		"prefix": "nfn",
		"body": [
			"fn ${1:outer}() {",
			"\tfn ${2:inner}($3) -> ${4:void} {",
			"\t\t$0",
			"\t}",
			"}"
		],
		"description": "Nested function declaration"
	},
	"Function Returning Closure": {
		"prefix": "fnc",
		"body": [
			"fn ${1:name}() -> fn(${2:Args}) -> ${3:ReturnType} {",
			"\t|$4| -> ${5:ReturnType} {",
			"\t\t$0",
			"\t}",
			"}"
		],
		"description": "Function that returns a closure"
	},
	"Import": {
		"prefix": "imp",
