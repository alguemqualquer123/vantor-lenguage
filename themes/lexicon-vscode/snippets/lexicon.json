		"prefix": "serve",
		"body": [
			"Http::serve(\"${1:0.0.0.0:3000}\");"
		],
		"description": "Start HTTP server (literal bind address)"
	},
	"HTTP Client Get": {
		"prefix": "httpg",
		"body": [
			"let ${1:response} = Http::get(\"${2:url}\");"
