	"Full API File": {
		"prefix": "api",
		"body": [
			"import core::net::Http;",
			"",
			"let app_env = Env::get(\"APP_ENV\");",
			"",
			"@Get(\"${1:/hello}\")",
			"pub fn ${2:hello}() -> String {",
			"\treturn ${3:\"Hello from Lexicon!\"};",
			"}",
			"",
			"pub fn main() -> void {",
			"\tprint(\"env=\" + app_env);",
			"\tHttp::serve(\"${4:0.0.0.0:3000}\");",
			"}"
		],
		"description": "Minimal runnable HTTP API file"
	},
	"Db Connect": {
		"prefix": "dbcon",
		"body": [
			"let ${1:db} = Db::connect(${2:url});"
		],
		"description": "Open database connection"
	},
	"Db Query": {
		"prefix": "dbq",
		"body": [
			"let ${1:rows} = Db::query(\"${2:SELECT id, name FROM users}\");"
		],
		"description": "Run SELECT query"
	},
	"Db Execute": {
		"prefix": "dbx",
		"body": [
