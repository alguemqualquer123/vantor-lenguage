{
	"Main Function": {
		"prefix": "main",
		"body": [
			"pub fn main() -> void {",
			"\t$0",
			"}"
		],
		"description": "Main entry point"
	},
	"Function": {
		"prefix": "fn",
		"body": [
			"fn ${1:name}(${2:params}) -> ${3:void} {",
			"\t$0",
			"}"
		],
		"description": "Function declaration"
	},
	"Public Function": {
		"prefix": "pfn",
		"body": [
			"pub fn ${1:name}(${2:params}) -> ${3:void} {",
			"\t$0",
			"}"
		],
		"description": "Public function declaration"
	},
	"Async Function": {
		"prefix": "afn",
		"body": [
			"pub async fn ${1:name}(${2:params}) -> ${3:void} {",
			"\t$0",
			"}"
		],
		"description": "Async function declaration"
	},
	"Generic Function": {
		"prefix": "gfn",
		"body": [
			"fn ${1:name}<${2:T}>(${3:arg}: ${2:T}) -> ${2:T} {",
			"\t$0",
			"}"
		],
		"description": "Generic function"
	},
	"Generic Bounded Function": {
		"prefix": "bgfn",
		"body": [
			"fn ${1:name}<${2:T}: ${3:Bound}>(${4:arg}: ${2:T}) -> ${2:T} {",
			"\t$0",
			"}"
		],
		"description": "Generic function with trait bound"
	},
	"Where Clause Function": {
		"prefix": "where",
		"body": [
			"fn ${1:name}<${2:T}>(${3:arg}: ${2:T}) -> ${4:ReturnType}",
			"\twhere ${2:T}: ${5:Bound}",
			"{",
			"\t$0",
			"}"
		],
		"description": "Function with where clause"
	},
	"Variadic Function": {
		"prefix": "vfn",
		"body": [
			"pub fn ${1:name}(${2:first}: ${3:int}, ${4:rest}: ${3:int}...) -> ${5:int} {",
			"\t$0",
			"}"
		],
		"description": "Variadic function (trailing ... must be last)"
	},
	"Let Variable": {
		"prefix": "let",
		"body": [
			"let ${1:name} = ${2:value};"
		],
		"description": "Immutable variable"
	},
	"Typed Let": {
		"prefix": "letc",
		"body": [
			"let ${1:name}: ${2:Type} = ${3:value};"
		],
		"description": "Typed variable declaration"
	},
	"Mutable Variable": {
		"prefix": "mut",
		"body": [
			"let mut ${1:name} = ${2:value};"
		],
		"description": "Mutable variable"
	},
	"Const": {
		"prefix": "const",
		"body": [
			"const ${1:NAME} = ${2:value};"
		],
		"description": "Compile-time constant"
	},
	"Static": {
		"prefix": "stat",
		"body": [
			"static ${1:NAME}: ${2:Type} = ${3:value};"
		],
		"description": "Static variable"
	},
	"Destructuring Let": {
		"prefix": "letd",
		"body": [
			"let (${1:a}, ${2:b}) = ${3:tuple};"
		],
		"description": "Tuple destructuring"
	},
	"If Statement": {
		"prefix": "if",
		"body": [
			"if ${1:condition} {",
			"\t$0",
			"}"
		],
		"description": "If statement"
	},
	"If Else": {
		"prefix": "ife",
		"body": [
			"if ${1:condition} {",
			"\t$2",
			"} else {",
			"\t$0",
			"}"
		],
		"description": "If-else statement"
	},
	"Match": {
		"prefix": "match",
		"body": [
			"match ${1:expr} {",
			"\t${2:pattern} => ${3:result},",
			"\t_ => ${4:default},",
			"}"
		],
		"description": "Match expression"
	},
	"Match Guard": {
		"prefix": "matchg",
		"body": [
			"match ${1:expr} {",
			"\t${2:n} if ${2:n} ${3:>} ${4:0} => ${5:result},",
			"\t_ => ${6:default},",
			"}"
		],
		"description": "Match with guard clause"
	},
	"Match Option": {
		"prefix": "mopt",
		"body": [
			"match ${1:option} {",
			"\tSome(${2:value}) => ${3:result},",
			"\tNone => ${4:default},",
			"}"
		],
		"description": "Match Option"
	},
	"Match Result": {
		"prefix": "mres",
		"body": [
			"match ${1:result} {",
			"\tOk(${2:value}) => ${3:success},",
			"\tErr(${4:error}) => ${5:failure},",
			"}"
		],
		"description": "Match Result"
	},
	"Match Bool Exhaustive": {
		"prefix": "mbool",
		"body": [
			"match ${1:flag} {",
			"\ttrue => ${2:on_true},",
			"\tfalse => ${3:on_false},",
			"}"
		],
		"description": "Exhaustive bool match"
	},
	"Switch": {
		"prefix": "switch",
		"body": [
			"switch ${1:expr} {",
			"\tcase ${2:1}:",
			"\t\t$3",
			"\tcase ${4:2}, ${5:3}:",
			"\t\t$6",
			"\tdefault:",
			"\t\t$0",
			"}"
		],
		"description": "Switch statement with cases and default"
	},
	"For Loop": {
		"prefix": "for",
		"body": [
			"for ${1:item} in ${2:iterable} {",
			"\t$0",
			"}"
		],
		"description": "For loop"
	},
	"For Range": {
		"prefix": "forr",
		"body": [
			"for ${1:i} in ${2:0}..${3:10} {",
			"\t$0",
			"}"
		],
		"description": "For over range"
	},
	"While Loop": {
		"prefix": "while",
		"body": [
			"while ${1:condition} {",
			"\t$0",
			"}"
		],
		"description": "While loop"
	},
	"Do While": {
		"prefix": "dowhile",
		"body": [
			"do {",
			"\t$0",
			"} while ${1:condition};"
		],
		"description": "Do-while loop"
	},
	"Infinite Loop": {
		"prefix": "loop",
		"body": [
			"loop {",
			"\t$0",
			"}"
		],
		"description": "Infinite loop"
	},
	"Break": {
		"prefix": "break",
		"body": [
			"break;"
		],
		"description": "Break statement"
	},
	"Continue": {
		"prefix": "cont",
		"body": [
			"continue;"
		],
		"description": "Continue statement"
	},
	"Return": {
		"prefix": "ret",
		"body": [
			"return ${1:value};"
		],
		"description": "Return with value"
	},
	"Return Void": {
		"prefix": "retv",
		"body": [
			"return;"
		],
		"description": "Bare return"
	},
	"Defer": {
		"prefix": "defer",
		"body": [
			"defer ${1:cleanup()};"
		],
		"description": "Deferred call (runs at scope unwind)"
	},
	"Struct": {
		"prefix": "struct",
		"body": [
			"struct ${1:Name} {",
			"\t${2:field}: ${3:Type},",
			"\t$0",
			"}"
		],
		"description": "Struct definition"
	},
	"Public Struct": {
		"prefix": "pstruct",
		"body": [
			"pub struct ${1:Name} {",
			"\tpub ${2:field}: ${3:Type},",
			"\t$0",
			"}"
		],
		"description": "Public struct definition"
	},
	"Struct Literal": {
		"prefix": "slit",
		"body": [
			"${1:Name} {",
			"\t${2:field}: ${3:value},",
			"\t$0",
			"}"
		],
		"description": "Struct literal"
	},
	"Enum": {
		"prefix": "enum",
		"body": [
			"enum ${1:Name} {",
			"\t${2:Variant1},",
			"\t${3:Variant2}(${4:Type}),",
			"\t$0",
			"}"
		],
		"description": "Enum definition"
	},
	"Trait": {
		"prefix": "trait",
		"body": [
			"trait ${1:Name} {",
			"\tfn ${2:method}(${3:params}) -> ${4:ReturnType};$0",
			"}"
		],
		"description": "Trait definition"
	},
	"Interface": {
		"prefix": "iface",
		"body": [
			"interface ${1:Name} {",
			"\tfn ${2:method}(${3:params}) -> ${4:ReturnType};$0",
			"}"
		],
		"description": "Interface definition"
	},
	"Class": {
		"prefix": "class",
		"body": [
			"class ${1:Name} {",
			"\t$0",
			"}"
		],
		"description": "Class definition"
	},
	"Class Implements": {
		"prefix": "classi",
		"body": [
			"class ${1:Name} implements ${2:Trait} {",
			"\tpub fn ${3:method}(${4:params}) -> ${5:ReturnType} {",
			"\t\t$0",
			"\t}",
			"}"
		],
		"description": "Class implementing a trait"
	},
	"Class Extends": {
		"prefix": "classe",
		"body": [
			"class ${1:Child} extends ${2:Parent} {",
			"\t$0",
			"}"
		],
		"description": "Class with inheritance"
	},
	"Type Alias": {
		"prefix": "type",
		"body": [
			"type ${1:Alias} = ${2:Type};"
		],
		"description": "Type alias"
	},
	"Print": {
		"prefix": "print",
		"body": [
			"print(${1:message});"
		],
		"description": "Print to stdout"
	},
	"Println": {
		"prefix": "println",
		"body": [
			"println(${1:message});"
		],
		"description": "Print line to stdout"
	},
	"Print Concat": {
		"prefix": "printf",
		"body": [
			"print(\"${1:text}\" + ${2:variable});"
		],
		"description": "Print with concatenation"
	},
	"Print Env": {
		"prefix": "printenv",
		"body": [
			"let ${1:cfg} = Env::get(\"${2:VAR_NAME}\");",
			"print(${1:cfg});"
		],
		"description": "Read env var into variable, then print (evaluates for real)"
	},
	"As Cast": {
		"prefix": "as",
		"body": [
			"${1:value} as ${2:Type}"
		],
		"description": "Explicit cast (required for narrowing)"
	},
	"HTTP Get Route": {
		"prefix": "get",
		"body": [
			"@Get(\"${1:/path}\")",
			"pub fn ${2:handler}() -> String {",
			"\treturn ${3:\"response\"};$0",
			"}"
		],
		"description": "HTTP GET route handler"
	},
	"HTTP Post Route": {
		"prefix": "post",
		"body": [
			"@Post(\"${1:/path}\")",
			"pub fn ${2:handler}() -> String {",
			"\treturn ${3:\"created\"};$0",
			"}"
		],
		"description": "HTTP POST route handler"
	},
	"HTTP Put Route": {
		"prefix": "put",
		"body": [
			"@Put(\"${1:/path}\")",
