	"Debug Print": {
		"prefix": "dbg",
		"body": [
			"dbg!(${1:expr});"
		],
		"description": "Debug print"
	},
	"Todo Comment": {
		"prefix": "todo",
		"body": [
			"// TODO: ${1:description}"
		],
		"description": "TODO comment"
	},
	"Fixme Comment": {
		"prefix": "fixme",
		"body": [
			"// FIXME: ${1:description}"
		],
		"description": "FIXME comment"
	},
	"Note Comment": {
		"prefix": "note",
		"body": [
			"// NOTE: ${1:description}"
		],
		"description": "NOTE comment"
	},
	"Http Server": {
		"prefix": "httpserv",
		"body": [
			"Http::serve(\"${1:0.0.0.0:3000}\", ${2:app});"
		],
		"description": "Start HTTP server"
	},
	"Context Get": {
		"prefix": "ctxg",
		"body": [
			"let ${1:value} = ctx.get::<${2:T}>(\"${3:key}\");"
		],
		"description": "Get from context"
	},
	"Context Set": {
		"prefix": "ctxs",
		"body": [
			"ctx.set(\"${1:key}\", ${2:value});"
		],
		"description": "Set in context"
	},
	"Middleware": {
		"prefix": "middleware",
		"body": [
			"@Middleware",
			"pub fn ${1:name}(ctx: Context, next: Next) -> Response {",
			"\t$0",
			"\treturn next(ctx);",
			"}"
		],
		"description": "Middleware function"
	},
	"Guard": {
		"prefix": "guard",
		"body": [
			"@Guard",
			"pub fn ${1:name}(ctx: Context) -> bool {",
			"\t$0",
			"}"
		],
		"description": "Guard function"
	},
	"Service": {
		"prefix": "service",
		"body": [
			"service ${1:Name} {",
			"\trpc ${2:getUser}(${3:id}: ${4:i32}) -> ${5:User};$0",
			"}"
		],
		"description": "Service definition"
	},
	"Pub Async Fn": {
		"prefix": "pafn",
		"body": [
			"pub async fn ${1:name}($2) -> ${3:Result} {",
			"\t$0",
			"}"
		],
		"description": "Public async function"
	},
	"Pub Fn Return": {
		"prefix": "pfnr",
		"body": [
			"pub fn ${1:name}($2) -> ${3:ReturnType} {",
			"\t$0",
			"}"
		],
		"description": "Public function with return type"
	},
	"Impl For": {
		"prefix": "implfor",
		"body": [
			"impl ${1:Trait} for ${2:Type} {",
			"\t$0",
			"}"
		],
		"description": "Impl trait for type"
	},
	"Type Alias": {
		"prefix": "typea",
		"body": [
			"type ${1:Alias} = ${2:Type};"
		],
		"description": "Type alias"
	},
	"Static": {
		"prefix": "static",
		"body": [
			"static ${1:NAME}: ${2:Type} = ${3:value};"
		],
		"description": "Static variable"
	},
	"Lazy Static": {
		"prefix": "lazys",
		"body": [
			"lazy_static! {",
			"\tstatic ref ${1:NAME}: ${2:Type} = ${3:value};",
			"}"
		],
		"description": "Lazy static"
	}
}
