	"Enum": {
		"prefix": "enum",
		"body": [
			"enum ${1:Name} {",
			"\t${2:Variant1},$0",
			"\t${3:Variant2}(${4:Type}),",
			"}"
		],
		"description": "Enum definition"
	},
	"Enum with Values": {
		"prefix": "enumv",
		"body": [
			"enum ${1:Name} {",
			"\t${2:Variant1} = ${3:1},",
			"\t${4:Variant2} = ${5:2},",
			"\t$0",
			"}"
		],
		"description": "Enum with integer values"
	},
	"Enum with Methods": {
		"prefix": "enumm",
		"body": [
			"enum ${1:Name} {",
			"\t${2:Variant1},",
			"\t${3:Variant2},",
			"}",
			"",
			"impl ${1:Name} {",
			"\tpub fn ${4:method}(&self) -> ${5:Type} {",
			"\t\tmatch self {",
			"\t\t\t${1:Name}::${2:Variant1} => ${6:value1},",
			"\t\t\t${1:Name}::${3:Variant2} => ${7:value2},",
			"\t\t}",
			"\t}",
			"}"
		],
		"description": "Enum with methods"
	},
	"C-like Enum": {
		"prefix": "cenum",
		"body": [
			"enum ${1:Name} {",
			"\t${2:Variant1} = 0,",
			"\t${3:Variant2} = 1,",
			"\t${4:Variant3} = 2,",
			"}"
		],
		"description": "C-like enum"
	},
	"Trait": {
		"prefix": "trait",
		"body": [
			"trait ${1:Name} {",
			"\tfn ${2:method}($3) -> ${4:ReturnType};$0",
			"}"
		],
		"description": "Trait definition"
	},
