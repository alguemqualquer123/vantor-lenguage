		"prefix": "implt",
		"body": [
			"impl ${1:Trait} for ${2:Type} {",
			"\tfn ${3:method}($4) -> ${5:ReturnType} {",
			"\t\t$0",
			"\t}",
			"}"
		],
		"description": "Impl trait for type"
	},
	"Constructor": {
		"prefix": "new",
		"body": [
			"pub fn new($1) -> Self {",
			"\t${2:Self} {",
			"\t\t$0",
			"\t}",
			"}"
		],
		"description": "Constructor method"
	},
	"Constructor Full": {
		"prefix": "con",
		"body": [
			"pub constructor($1) {",
			"\t$0",
			"}"
		],
		"description": "Class constructor"
	},
	"Private Constructor": {
		"prefix": "pcon",
		"body": [
			"fn new($1) -> Self {",
			"\tSelf {",
			"\t\t$0",
			"\t}",
			"}"
		],
		"description": "Private constructor"
	},
	"Static Constructor": {
		"prefix": "scon",
		"body": [
			"pub static fn create($1) -> Self {",
			"\t$0",
			"}"
		],
		"description": "Static factory method"
	},
