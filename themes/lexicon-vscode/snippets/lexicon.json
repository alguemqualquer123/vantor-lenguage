	"Class with Constructor": {
		"prefix": "classc",
		"body": [
			"class ${1:Name} {",
			"\tpub ${2:field}: ${3:Type},",
			"",
			"\tpub constructor($4) {",
			"\t\tthis.${2:field} = $5;",
			"\t}",
			"}"
		],
		"description": "Class with constructor"
