{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Lexicon",
	"scopeName": "source.lexicon",
	"version": "1.0.0",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#http_decorators" },
		{ "include": "#annotations" },
		{ "include": "#attributes" },
		{ "include": "#strings" },
		{ "include": "#this_self" },
		{ "include": "#keywords" },
		{ "include": "#functions" },
		{ "include": "#function_calls" },
		{ "include": "#type_definitions" },
		{ "include": "#types" },
		{ "include": "#constants" },
		{ "include": "#closures" },
		{ "include": "#operators" },
		{ "include": "#punctuation" },
		{ "include": "#namespace" },
		{ "include": "#struct_shorthand" },
		{ "include": "#parameters" },
		{ "include": "#objects" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{ "include": "#comment-block-doc" },
				{ "include": "#comment-block" },
				{ "include": "#comment-line-doc" },
				{ "include": "#comment-line-inner-doc" },
				{ "include": "#comment-line-region" },
				{ "include": "#comment-line" }
			]
		},
		"comment-line-doc": {
			"name": "comment.line.documentation.lexicon",
			"begin": "(^\\s*)(///)(?!/)",
			"end": "$",
			"beginCaptures": {
				"2": { "name": "punctuation.definition.comment.documentation.lexicon" }
			},
			"patterns": [{ "include": "#comment-inline" }]
		},
		"comment-line-inner-doc": {
			"name": "comment.line.documentation.inner.lexicon",
			"begin": "(^\\s*)(//!)(?!/)",
			"end": "$",
			"beginCaptures": {
				"2": { "name": "punctuation.definition.comment.documentation.lexicon" }
			},
			"patterns": [{ "include": "#comment-inline" }]
		},
		"comment-line-region": {
			"name": "meta.region.lexicon",
			"match": "^\\s*(//)\\s*(#?(?:region|endregion)\\b.*)$",
			"captures": {
				"1": { "name": "punctuation.definition.comment.lexicon" },
				"2": { "name": "comment.line.region.lexicon" }
			}
		},
		"comment-line": {
			"name": "comment.line.double-slash.lexicon",
			"begin": "(//)",
			"end": "$",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.comment.lexicon" }
			},
			"patterns": [{ "include": "#comment-inline" }]
		},
		"comment-block-doc": {
			"name": "comment.block.documentation.lexicon",
			"begin": "/\\*\\*(?!/)",
			"end": "\\*/",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.comment.begin.lexicon" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.comment.end.lexicon" }
			},
			"patterns": [{ "include": "#comment-inline" }, { "include": "#comments" }]
		},
		"comment-block": {
			"name": "comment.block.lexicon",
			"begin": "/\\*(?!\\*)",
			"end": "\\*/",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.comment.begin.lexicon" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.comment.end.lexicon" }
			},
			"patterns": [{ "include": "#comment-inline" }, { "include": "#comments" }]
		},
		"comment-inline": {
			"patterns": [
				{
					"match": "(?i)\\b(TODO|HACK|XXX|WIP|TBD)\\b(:)?",
					"captures": {
						"1": { "name": "comment.line.todo.lexicon comment.block.todo.lexicon todo.lexicon" },
						"2": { "name": "punctuation.separator.todo-colon.lexicon comment.line.todo.colon.lexicon" }
					}
				},
				{
					"match": "(?i)\\b(FIXME|BUG)\\b(:)?",
					"captures": {
						"1": { "name": "comment.line.fixme.lexicon comment.block.fixme.lexicon fixme.lexicon" },
						"2": { "name": "punctuation.separator.todo-colon.lexicon comment.line.fixme.colon.lexicon" }
					}
				},
				{
					"match": "(?i)\\b(NOTE|SAFETY|PERF|TEMP)\\b(:)?",
					"captures": {
						"1": { "name": "comment.line.note.lexicon comment.block.note.lexicon note.lexicon" },
						"2": { "name": "punctuation.separator.todo-colon.lexicon comment.line.note.colon.lexicon" }
					}
				},
				{
					"name": "markup.underline.link.lexicon",
					"match": "\\b(?:https?://|file://|vscode://|www\\.)[^\\s`<>\"'\\]]+"
				},
				{
					"name": "markup.inline.raw.lexicon",
					"match": "`[^`\\n]+`"
				},
				{
					"name": "keyword.other.documentation.marker.lexicon",
					"match": "@[A-Za-z_][A-Za-z0-9_]*"
				}
			]
		},
		"http_decorators": {
			"patterns": [
				{ "name": "keyword.http.get.lexicon", "match": "@Get\\([^)]*\\)" },
				{ "name": "keyword.http.post.lexicon", "match": "@Post\\([^)]*\\)" },
				{ "name": "keyword.http.put.lexicon", "match": "@Put\\([^)]*\\)" },
				{ "name": "keyword.http.delete.lexicon", "match": "@Delete\\([^)]*\\)" },
				{ "name": "keyword.http.patch.lexicon", "match": "@Patch\\([^)]*\\)" },
				{ "name": "keyword.http.test.lexicon", "match": "@Test\\b" }
			]
		},
		"annotations": {
			"patterns": [
				{ "name": "entity.name.function.decorator.lexicon", "match": "@[a-zA-Z_][a-zA-Z0-9_]*" }
			]
		},
		"attributes": {
			"patterns": [
				{ "name": "entity.name.attribute.cfg.lexicon", "match": "#\\[cfg\\([^\\]]*\\)\\]" },
				{ "name": "entity.name.attribute.lexicon", "match": "#\\[[^\\]]+\\]" }
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.lexicon",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.lexicon", "match": "\\\\." },
						{
							"name": "variable.other.string-interpolation.lexicon",
							"begin": "\\{",
							"end": "\\}",
							"patterns": [{ "include": "$self" }]
						}
					]
				},
				{
					"name": "string.quoted.single.char.lexicon",
					"begin": "'",
					"end": "'",
					"patterns": [
						{ "name": "constant.character.escape.lexicon", "match": "\\\\." }
					]
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.conditional.lexicon",
					"match": "\\b(if|else|switch|case|default|match)\\b"
				},
				{
					"name": "keyword.control.loop.lexicon",
					"match": "\\b(for|while|loop|do|in|break|continue)\\b"
				},
				{
					"name": "keyword.control.flow.lexicon",
					"match": "\\b(return|defer|yield|where)\\b"
				},
				{
					"name": "keyword.declaration.function.lexicon",
					"match": "\\b(fn|lambda)\\b"
				},
				{
					"name": "keyword.declaration.type.lexicon",
					"match": "\\b(struct|enum|class|trait|interface|type|effect|constructor)\\b"
				},
				{
					"name": "keyword.declaration.variable.lexicon",
					"match": "\\b(let|var|mut|const|static|ref)\\b"
				},
				{
					"name": "keyword.module.lexicon",
					"match": "\\b(module|import|as|extends|implements|with|derive)\\b"
				},
				{
					"name": "keyword.modifier.visibility.lexicon",
					"match": "\\b(pub|private|protected)\\b"
				},
				{
					"name": "keyword.modifier.async.lexicon",
					"match": "\\b(async|await|task|actor|spawn|select|channel)\\b"
				},
				{
					"name": "keyword.modifier.unsafe.lexicon",
					"match": "\\b(unsafe|extern|native|inline)\\b"
				},
				{
					"name": "keyword.exception.lexicon",
					"match": "\\b(try|catch|throw|finally|panic|recover)\\b"
				},
				{
					"name": "keyword.other.lexicon",
					"match": "\\b(self|super|new|is|macro|dynamic|function)\\b"
				},
				{
					"name": "constant.language.boolean.lexicon",
					"match": "\\b(true|false)\\b"
				},
				{
					"name": "constant.language.null.lexicon",
					"match": "\\b(null|None)\\b"
				},
				{
					"name": "entity.name.option.lexicon",
					"match": "\\b(Some|Ok|Err)\\b"
				},
				{
					"name": "storage.type.primitive.lexicon",
					"match": "\\b(bool|int|uint|byte|rune|char|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64|float32|float64|decimal|void)\\b"
				},
				{
					"name": "storage.type.string.lexicon",
					"match": "\\b(string|String)\\b"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.definition.lexicon",
					"match": "(?<=\\bfn\\s)[a-zA-Z_][a-zA-Z0-9_]*"
				},
				{
					"name": "entity.name.function.definition.async.lexicon",
					"match": "\\b(async)\\s+(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
					"captures": {
						"1": { "name": "keyword.modifier.async.lexicon" },
						"2": { "name": "keyword.declaration.function.lexicon" },
						"3": { "name": "entity.name.function.lexicon" }
					}
				},
				{
					"name": "support.function.builtin.print.lexicon",
					"match": "\\b(print|println)\\b(?=\\s*\\()"
				},
				{
					"name": "support.function.builtin.panic.lexicon",
					"match": "\\b(panic|recover|assert|inspect)\\b(?=\\s*\\()"
				}
			]
		},
		"function_calls": {
			"patterns": [
				{
					"name": "entity.name.function.call.lexicon",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
				},
				{
					"name": "entity.name.function.method.lexicon",
					"match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
				}
			]
		},
		"type_definitions": {
			"patterns": [
				{
					"match": "\\b(struct|enum|class|trait|interface|type|effect)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
					"captures": {
						"1": { "name": "keyword.declaration.type.lexicon" },
						"2": { "name": "entity.name.type.definition.lexicon" }
					}
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.generic.lexicon",
					"match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(?=<)"
				},
				{
					"name": "entity.name.type.lexicon",
					"match": "\\b([A-Z][a-zA-Z0-9_]*)\\b"
				},
				{
					"name": "storage.type.collection.lexicon",
					"match": "\\b(Array|List|Map|Set|Vec|Option|Result)\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{ "name": "constant.numeric.hex.lexicon", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
				{ "name": "constant.numeric.binary.lexicon", "match": "\\b0[bB][01_]+\\b" },
				{ "name": "constant.numeric.float.lexicon", "match": "\\b[0-9][0-9_]*\\.[0-9_]+([eE][+-]?[0-9_]+)?\\b" },
				{ "name": "constant.numeric.float.exponent.lexicon", "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9_]+\\b" },
				{ "name": "constant.numeric.integer.lexicon", "match": "\\b[0-9][0-9_]*\\b" }
			]
		},
		"this_self": {
			"patterns": [
				{ "name": "variable.language.self.lexicon", "match": "\\b(self|super)\\b" }
			]
		},
		"closures": {
			"patterns": [
				{
					"name": "keyword.operator.closure.lexicon",
					"match": "\\|[^|\\n]+\\|"
				},
				{
					"name": "keyword.operator.closure-arrow.lexicon",
					"match": "=>"
				}
			]
		},
		"operators": {
			"patterns": [
				{ "name": "keyword.operator.pipe.lexicon", "match": "(\\|>)" },
				{ "name": "keyword.operator.arrow.lexicon", "match": "(->)" },
				{ "name": "keyword.operator.spread.lexicon", "match": "(\\.\\.\\.)" },
				{ "name": "keyword.operator.range.lexicon", "match": "(\\.\\.=|\\.\\.)" },
				{ "name": "keyword.operator.nullable.lexicon", "match": "(\\?\\?|\\?\\.|\\?)" },
				{ "name": "keyword.operator.comparison.lexicon", "match": "(==|!=|<=|>=)" },
				{ "name": "keyword.operator.logical.lexicon", "match": "(&&|\\|\\||!)" },
				{ "name": "keyword.operator.bitwise.lexicon", "match": "(<<|>>|&|\\||\\^|~)" },
				{ "name": "keyword.operator.arithmetic.lexicon", "match": "(\\+=|-=|\\*=|/=|%=|\\+\\+|--|\\+|-|\\*|/|%)" },
				{ "name": "keyword.operator.assignment.lexicon", "match": "(=>|=)" },
				{ "name": "keyword.operator.path.lexicon", "match": "(::)" },
				{ "name": "keyword.operator.member.lexicon", "match": "(\\.)" }
			]
		},
		"punctuation": {
			"patterns": [
				{ "name": "punctuation.bracket.lexicon", "match": "[\\(\\)\\[\\]\\{\\}]" },
				{ "name": "punctuation.separator.lexicon", "match": "[,;]" },
				{ "name": "punctuation.definition.colon.lexicon", "match": ":(?!:)" },
				{ "name": "punctuation.definition.hash.lexicon", "match": "#(?!\\[)" },
				{ "name": "variable.other.placeholder.lexicon", "match": "(?<![a-zA-Z0-9_])_(?![a-zA-Z0-9_])" }
			]
		},
		"namespace": {
			"patterns": [
				{
					"name": "entity.name.namespace.lexicon",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=::)"
				}
			]
		},
		"struct_shorthand": {
			"patterns": [
				{
					"name": "variable.other.object.shorthand.lexicon",
					"match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=[,}])"
				}
			]
		},
		"objects": {
			"patterns": [
				{
					"name": "variable.object.property.lexicon",
					"match": "(?<=\\.)[a-z_][a-zA-Z0-9_]*"
				},
				{
					"name": "variable.object.key.lexicon",
					"match": "([a-z_][a-zA-Z0-9_]*)(?=\\s*:)"
				}
			]
		},
		"parameters": {
			"patterns": [
				{
					"name": "variable.parameter.lexicon",
					"match": "([a-z_][a-zA-Z0-9_]*)(?=\\s*:)"
				}
			]
		}
	}
}
