  "tokenColors": [
    {
      "name": "Lexicon comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A867B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Lexicon doc comments",
      "scope": [
        "comment.line.documentation.lexicon",
        "comment.line.documentation.lex"
      ],
      "settings": {
        "foreground": "#1E7E34",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Lexicon control flow",
      "scope": [
        "keyword.control.conditional.lexicon",
        "keyword.control.loop.lexicon",
        "keyword.control.flow.lexicon",
        "keyword.control.lexicon",
        "keyword.control.conditional.lex",
        "keyword.control.loop.lex",
        "keyword.control.flow.lex",
        "keyword.control.lex"
      ],
      "settings": {
        "foreground": "#7B2FBE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Lexicon declarations",
      "scope": [
        "keyword.declaration.function.lexicon",
        "keyword.declaration.type.lexicon",
        "keyword.declaration.variable.lexicon",
        "keyword.declaration.function.lex",
        "keyword.declaration.type.lex",
        "keyword.declaration.variable.lex"
      ],
      "settings": {
        "foreground": "#7B2FBE"
      }
    },
    {
