      "settings": {
        "foreground": "#FF7B72"
      }
    },
    {
      "name": "Pipe Operator",
      "scope": [
        "keyword.operator.pipe.lexicon",
        "keyword.operator.pipe.lex"
      ],
      "settings": {
        "foreground": "#58A6FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Lexicon arrows/nullable",
      "scope": [
