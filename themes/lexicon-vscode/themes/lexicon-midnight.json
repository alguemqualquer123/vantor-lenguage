      "settings": {
        "foreground": "#4FC1FF",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Primitive Types",
      "scope": [
        "support.type.primitive.lexicon",
        "support.type.primitive.lex"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Lexicon storage types",
      "scope": [
        "storage.type.primitive.lexicon",
        "storage.type.string.lexicon",
        "storage.type.collection.lexicon",
        "storage.type.generic.lexicon",
        "storage.type.primitive.lex",
        "storage.type.string.lex",
        "storage.type.collection.lex",
        "storage.type.generic.lex"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Annotations/Decorators",
      "scope": [
        "entity.name.function.decorator.lexicon",
        "entity.name.function.decorator.lex"
      ],
      "settings": {
        "foreground": "#DCDCAA",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Lexicon cfg attributes",
      "scope": [
        "entity.name.attribute.cfg.lexicon",
        "entity.name.attribute.lexicon",
        "entity.name.attribute.cfg.lex",
        "entity.name.attribute.lex"
      ],
      "settings": {
        "foreground": "#DCDCAA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator.lexicon",
