{
  "name": "Lexicon Midnight",
  "type": "dark",
  "colors": {
    "editor.background": "#020408",
    "editor.foreground": "#C9D1D9",
    "activityBar.background": "#000000",
    "sideBar.background": "#000000",
    "statusBar.background": "#000000",
    "editorLineNumber.foreground": "#484F58",
    "editorLineNumber.activeForeground": "#F0F6FC",
    "editorIndentGuide.background": "#21262D",
    "editor.selectionBackground": "#3392FF44",
    "editorBracketHighlight.foreground1": "#79C0FF",
    "editorBracketHighlight.foreground2": "#D2A8FF",
    "editorBracketHighlight.foreground3": "#7EE787",
    "editorBracketHighlight.foreground4": "#FFA657",
    "editorBracketHighlight.foreground5": "#FF7B72",
    "editorBracketHighlight.foreground6": "#56D4DD",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FF7B72"
  },
  "tokenColors": [
    {
      "name": "Keywords",
      "scope": [
        "keyword.control.lexicon",
        "keyword.control.lex"
      ],
      "settings": {
        "foreground": "#FF7B72",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Lexicon control flow",
      "scope": [
        "keyword.control.conditional.lexicon",
        "keyword.control.loop.lexicon",
        "keyword.control.flow.lexicon",
        "keyword.control.conditional.lex",
        "keyword.control.loop.lex",
        "keyword.control.flow.lex"
      ],
      "settings": {
        "foreground": "#FF7B72",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Lexicon declarations",
      "scope": [
        "keyword.declaration.function.lexicon",
        "keyword.declaration.type.lexicon",
        "keyword.declaration.variable.lexicon",
        "keyword.declaration.function.lex",
        "keyword.declaration.type.lex",
        "keyword.declaration.variable.lex"
      ],
      "settings": {
        "foreground": "#FF7B72"
      }
    },
    {
      "name": "Lexicon modules/modifiers",
      "scope": [
        "keyword.module.lexicon",
        "keyword.modifier.visibility.lexicon",
        "keyword.modifier.async.lexicon",
        "keyword.modifier.unsafe.lexicon",
        "keyword.module.lex",
        "keyword.modifier.visibility.lex",
        "keyword.modifier.async.lex",
        "keyword.modifier.unsafe.lex"
      ],
      "settings": {
        "foreground": "#D2A8FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Lexicon exceptions",
      "scope": [
        "keyword.exception.lexicon",
        "keyword.exception.lex"
      ],
      "settings": {
        "foreground": "#FF7B72",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function.lexicon",
        "entity.name.function.lex"
      ],
      "settings": {
        "foreground": "#D2A8FF"
      }
    },
    {
      "name": "Lexicon fn definitions",
      "scope": [
        "entity.name.function.definition.lexicon",
        "entity.name.function.definition.async.lexicon",
        "entity.name.function.definition.lex",
        "entity.name.function.definition.async.lex"
      ],
      "settings": {
        "foreground": "#79C0FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Lexicon builtins",
      "scope": [
        "support.function.builtin.print.lexicon",
        "support.function.builtin.panic.lexicon",
        "support.function.builtin.print.lex",
        "support.function.builtin.panic.lex"
      ],
      "settings": {
        "foreground": "#58A6FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string.quoted.double.lexicon",
        "string.quoted.double.lex"
      ],
      "settings": {
        "foreground": "#A5D6FF"
      }
    },
    {
      "name": "Lexicon interpolation",
      "scope": [
        "variable.other.string-interpolation.lexicon",
        "variable.other.string-interpolation.lex"
      ],
      "settings": {
        "foreground": "#79C0FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Lexicon char literal",
      "scope": [
        "string.quoted.single.char.lexicon",
        "string.quoted.single.char.lex"
      ],
      "settings": {
        "foreground": "#A5D6FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric.lexicon",
        "constant.numeric.lex"
      ],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "Lexicon hex/binary",
      "scope": [
        "constant.numeric.hex.lexicon",
        "constant.numeric.binary.lexicon",
        "constant.numeric.hex.lex",
        "constant.numeric.binary.lex"
      ],
      "settings": {
        "foreground": "#D2A8FF"
      }
    },
    {
      "name": "Custom Types (PascalCase)",
      "scope": [
        "entity.name.type.lexicon",
        "entity.name.type.lex"
      ],
      "settings": {
        "foreground": "#4FC1FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Lexicon type definitions",
      "scope": [
        "entity.name.type.definition.lexicon",
        "entity.name.type.definition.lex"
