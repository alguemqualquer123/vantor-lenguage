      "settings": {
        "foreground": "#D2A8FF"
      }
    },
    {
      "name": "Lexicon params/props",
      "scope": [
        "variable.parameter.lexicon",
        "variable.object.property.lexicon",
        "variable.object.key.lexicon",
        "variable.parameter.lex",
        "variable.object.property.lex",
        "variable.object.key.lex"
      ],
      "settings": {
        "foreground": "#79C0FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Lexicon doc comments",
