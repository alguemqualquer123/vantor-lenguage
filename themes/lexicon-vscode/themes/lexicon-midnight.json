      "scope": [
        "comment",
        "comment.line.double-slash.lexicon",
        "comment.block.lexicon",
        "punctuation.definition.comment.lexicon",
        "punctuation.definition.comment.begin.lexicon",
        "punctuation.definition.comment.end.lexicon",
        "comment.line.double-slash.lex",
        "comment.block.lex",
        "punctuation.definition.comment.lex",
