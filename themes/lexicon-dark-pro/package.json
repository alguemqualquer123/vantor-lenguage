{
  "name": "lexicon-dark-pro",
  "displayName": "Lexicon Dark Pro",
  "description": "A professional dark theme for VSCode with modern identity, optimal contrast for long coding sessions, and support for modern languages.",
  "version": "1.0.0",
  "publisher": "lexicon",
  "author": "Lexicon Team",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "icon": "icons/lexicon-icon.png",
  "keywords": [
    "dark",
    "theme",
    "lexicon",
    "programming",
    "modern",
    "minimalist"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Lexicon Dark Pro",
        "uiTheme": "vs-dark",
        "path": "./themes/lexicon-dark-pro-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "lexicon-dark-pro-icons",
        "label": "Lexicon Dark Pro Icons",
        "path": "./themes/lexicon-dark-pro-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "lexicon",
        "aliases": ["Lexicon", "LexiconLang"],
        "extensions": [".lex"],
        "icon": {
          "light": "./icons/lexicon-icon.png",
          "dark": "./icons/lexicon-icon.png"
        },
        "grammars": [
          {
            "language": "lexicon",
            "scopeName": "source.lexicon",
            "path": "./syntaxes/lexicon.tmLanguage.json"
          }
        ]
      },
      {
        "id": "lexicontoml",
        "aliases": ["Lexicon Config", "Lexicon TOML"],
        "extensions": [".lexicon.toml", "lexicon.toml"],
        "icon": {
          "light": "./icons/lexicon-icon.png",
          "dark": "./icons/lexicon-icon.png"
        }
      }
    ],
    "debuggers": [
      {
        "type": "lexicon",
        "label": "Lexicon Debugger",
        "languages": ["lexicon"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the Lexicon source file to debug"
              },
              "args": {
                "type": "array",
                "description": "Command line arguments passed to the program",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debugger"
              },
              "env": {
                "type": "object",
                "description": "Environment variables",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop on entry",
                "default": true
              },
              "trace": {
                "type": "boolean",
                "description": "Enable tracing of debugger messages",
                "default": false
              },
              "debugServer": {
                "type": "number",
                "description": "Port to attach the debug server (for external debug adapter)"
              },
              "runtime": {
                "type": "string",
                "description": "Path to Lexicon CLI executable",
                "default": "lexicon"
              },
              "sourceMaps": {
                "type": "boolean",
                "description": "Enable source maps",
                "default": true
              },
              "smartStep": {
                "type": "boolean",
                "description": "Automatically skip generated code",
                "default": true
              },
              "evaluateForHovers": {
                "type": "boolean",
                "description": "Enable evaluation of expressions on hover",
                "default": true
              },
              "breakpoints": {
                "type": "array",
                "description": "Initial breakpoints",
                "items": {
                  "type": "object",
                  "properties": {
                    "line": {
                      "type": "number"
                    },
                    "column": {
                      "type": "number"
                    },
                    "condition": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "attach": {
            "properties": {
              "address": {
                "type": "string",
                "description": "TCP/IP address of debug server"
              },
              "port": {
                "type": "number",
                "description": "TCP/IP port of debug server",
                "default": 4711
              },
              "restart": {
                "type": "boolean",
                "description": "Restart connection after termination",
                "default": false
              },
              "trace": {
                "type": "boolean",
                "description": "Enable tracing",
                "default": false
              },
              "localRoot": {
                "type": "string",
                "description": "Path to the local source root"
              },
              "remoteRoot": {
                "type": "string",
                "description": "Path to the remote source root"
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Lexicon Configuration",
      "properties": {
        "lexicon.debug.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Lexicon debugger support"
        },
        "lexicon.debug.server": {
          "type": "number",
          "default": 4711,
          "description": "Debug server port"
        },
        "lexicon.debug.runtime": {
          "type": "string",
          "default": "lexicon",
          "description": "Path to Lexicon CLI executable"
        },
        "lexicon.debug.console": {
          "type": "string",
          "enum": ["internalConsole", "integratedTerminal", "externalTerminal"],
          "default": "integratedTerminal",
          "description": "Where to show debug output"
        },
        "lexicon.debug.cwd": {
          "type": "string",
          "default": "${workspaceFolder}",
          "description": "Working directory for debugged program"
        },
        "lexicon.build.outputDir": {
          "type": "string",
          "default": "target/lexicon",
          "description": "Output directory for build artifacts"
        },
        "lexicon.format.tabSize": {
          "type": "number",
          "default": 4,
          "description": "Tab size for formatting"
        },
        "lexicon.format.insertSpaces": {
          "type": "boolean",
          "default": true,
          "description": "Insert spaces instead of tabs"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "lexicon",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "enum": ["build", "run", "test", "check", "fmt"],
            "description": "The Lexicon task to run"
          },
          "args": {
            "type": "array",
            "description": "Additional arguments",
            "items": {
              "type": "string"
            }
          },
          "release": {
            "type": "boolean",
            "description": "Build in release mode",
            "default": false
          }
        }
      }
    ],
    "snippets": [
      {
        "language": "lexicon",
        "path": "./snippets/lexicon.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lexicon/lexicon-dark-pro"
  }
}
