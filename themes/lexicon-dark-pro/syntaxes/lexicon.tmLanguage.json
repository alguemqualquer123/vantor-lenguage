{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Lexicon",
	"scopeName": "source.lexicon",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#keywords" },
		{ "include": "#strings" },
		{ "include": "#constants" },
		{ "include": "#operators" },
		{ "include": "#annotations" },
		{ "include": "#function_calls" },
		{ "include": "#struct_shorthand" },
		{ "include": "#types" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{ "name": "comment.line.double-slash.lexicon", "match": "//.*$" },
				{ "name": "comment.block.lexicon", "begin": "/\\*", "end": "\\*/" }
			]
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.control.lexicon",
				"match": "\\b(if|else|for|while|loop|break|continue|return|module|import|pub|private|protected|class|struct|enum|trait|interface|type|fn|async|let|var|mut|const|static|new|as|is|assert|constructor|self|await)\\b"
			}]
		},
		"annotations": {
			"patterns": [{
				"name": "entity.name.function.decorator.lexicon",
				"match": "@[a-zA-Z_][a-zA-Z0-9_]*"
			}]
		},
		"strings": {
			"patterns": [{
				"name": "string.quoted.double.lexicon",
				"begin": "\"",
				"end": "\"",
				"patterns": [
					{ "name": "constant.character.escape.lexicon", "match": "\\\\." },
					{
						"name": "variable.other.interpolation.lexicon",
						"begin": "{",
						"end": "}",
						"captures": {
							"0": { "name": "punctuation.definition.template-expression.lexicon" }
						}
					}
				]
			}]
		},
		"constants": {
			"patterns": [
				{ "name": "constant.language.lexicon", "match": "\\b(true|false|null)\\b" },
				{ "name": "constant.numeric.lexicon", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
			]
		},
		"operators": {
			"patterns": [
				{ "name": "keyword.operator.pipe.lexicon", "match": "(▷|\\|>)" },
				{ "name": "keyword.operator.lexicon", "match": "(==|!=|<=|>=|&&|\\|\\||\\?|\\?\\?|->|=>|::|\\+|-|\\*|/|=)" }
			]
		},
		"function_calls": {
			"patterns": [{
				"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
				"captures": {
					"1": { "name": "entity.name.function.lexicon" }
				}
			}]
		},
		"types": {
			"patterns": [
				{
					"match": "\\b(i32|i64|f32|f64|bool|char|string|void|int|float|boolean)\\b",
					"name": "support.type.primitive.lexicon"
				},
				{
					"match": "\\b([A-Z][a-zA-Z0-9_]*)\\b",
					"name": "entity.name.type.lexicon"
				}
			]
		},
		"struct_shorthand": {
			"patterns": [
				{
					"match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=[,}])",
					"captures": {
						"1": { "name": "variable.other.lexicon" }
					}
				}
			]
		}
	}
}
